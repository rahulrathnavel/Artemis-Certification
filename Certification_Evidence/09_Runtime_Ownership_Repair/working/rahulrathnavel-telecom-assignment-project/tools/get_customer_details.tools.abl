TOOLS:
  get_customer_details(customer_id: string) -> object
    description: "Retrieve customer records matching the supplied Customer ID so the customer’s actual account_type can be obtained."
    type: http
    params:
      customer_id:
        description: "Customer ID in the format CUST followed by four digits, for example CUST1001."
    endpoint: "https://telecom-customer-data.onrender.com/customers"
    method: GET
    query_params:
      customer_id: "{{input.customer_id}}"
    body_mode: none