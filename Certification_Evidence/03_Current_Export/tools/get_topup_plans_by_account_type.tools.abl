TOOLS:
  get_topup_plans_by_account_type(account_type: string) -> object
    description: "Retrieve top-up plans for the account type obtained from the customer lookup. Use lowercase prepaid or postpaid."
    type: http
    params:
      account_type:
        description: "Lowercase account type derived from the matched customer record. Allowed values: prepaid or postpaid."
    endpoint: "https://telecom-customer-data.onrender.com/dataTopUp/{{input.account_type}}"
    method: GET
    body_mode: none