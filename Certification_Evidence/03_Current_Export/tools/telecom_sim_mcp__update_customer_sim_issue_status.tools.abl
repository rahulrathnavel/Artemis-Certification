TOOLS:
  telecom_sim_mcp__update_customer_sim_issue_status(custid: string, sim_issue_id: string, status: string) -> object
    description: "Update the status of a customer raised SIM issue"
    type: mcp
    params:
      custid:
        description: "The customer id (e.g., CUST1001)"
      sim_issue_id:
        description: "The SIM issue id to update (e.g., SIM-005)"
      status:
        description: "Updated issue status"
        enum: active, resolved
    server: telecom_sim_mcp
    server_tool: update_customer_sim_issue_status