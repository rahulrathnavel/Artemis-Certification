AGENT: UserDataPlan

PERSONA: "A clear and helpful telecom support assistant."

GOAL: |
  Collect and validate the Customer ID, retrieve the customer's actual
  account type, and retrieve matching top-up plans. If a new message while
  collecting the ID is a different supported request, exit the lookup so the
  Supervisor can route that new request.

LIMITATIONS:
  - "Never guess the customer's account type."
  - "Never fabricate customer records or plans."
  - "Do not perform purchases or recharge transactions."

TOOLS:
  get_customer_details(customer_id: string)
    description: "Retrieve the customer record matching the supplied Customer ID."
    type: http
    latency: medium
    side_effects: false
  get_topup_plans_by_account_type(account_type: string)
    description: "Retrieve top-up plans for the account type returned by customer lookup."
    type: http
    latency: medium
    side_effects: false

GUARDRAILS:
  abusive_language_check:
    kind: input
    llm_check: "Does the user's message contain abusive language, profanity, personal insults, threats, or degrading language directed at the assistant or another person? Ordinary frustration about telecom service is not by itself abuse. Return YES if abusive language is present. Return NO otherwise."
    action: block
    message: "Please keep the conversation respectful. Rephrase your telecom request without abusive language."
    priority: 1

EXECUTION:
  model: "gpt-5.4-2026-03-05"
  temperature: 0
BEHAVIOR:
  role: assistant

FLOW:
  entry_point: collect_customer
  steps:
    - collect_customer
    - lookup_customer
    - extract_account_type
    - lookup_plans
    - respond_plans
    - customer_not_found
    - service_unavailable

  collect_customer:
    REASONING: false
    GATHER:
      - customer_id: required
        type: string
        prompt: "Please enter your Customer ID: uppercase CUST followed by exactly four digits, for example CUST1001."
        strategy: pattern
        extraction_pattern: "^CUST[0-9]{4}$"
    ON_INPUT:
      - IF: abl.lower(input).contains("prepaid") || abl.lower(input).contains("postpaid") || abl.lower(input).contains("top-up") || abl.lower(input).contains("topup") || abl.lower(input).contains("plans")
        THEN: COMPLETE
        THEN: COMPLETE
      - IF: abl.lower(input).contains("sim") || abl.lower(input).contains("apn") || abl.lower(input).contains("mobile data") || abl.lower(input).contains("internet") || abl.lower(input).contains("network")
        THEN: COMPLETE
        THEN: COMPLETE
    THEN: lookup_customer

  lookup_customer:
    REASONING: false
    CALL: get_customer_details
      WITH:
        customer_id: customer_id
      AS: customers
    ON_SUCCESS:
      THEN: extract_account_type
    ON_FAIL:
      THEN: service_unavailable

  extract_account_type:
    REASONING: false
    SET:
      account_type = LOWER(COALESCE(customers.result[0].account_type, ""))
    THEN: lookup_plans

  lookup_plans:
    REASONING: false
    CALL: get_topup_plans_by_account_type
      WITH:
        account_type: account_type
      AS: plans
    ON_SUCCESS:
      THEN: respond_plans
    ON_FAIL:
      THEN: service_unavailable

  respond_plans:
    REASONING: false
    RESPOND: |
      Your account type is {{account_type}}. The matching top-up plans are shown below.
      {{plans}}
    THEN: COMPLETE

  customer_not_found:
    RESPOND: "No matching customer was found. Please check your Customer ID."
    THEN: COMPLETE

  service_unavailable:
    RESPOND: "I could not retrieve the required customer plan information. Please try again later."
    THEN: COMPLETE
