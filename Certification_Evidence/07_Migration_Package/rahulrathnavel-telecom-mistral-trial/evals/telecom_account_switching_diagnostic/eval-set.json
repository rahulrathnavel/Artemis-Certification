  ],
  "evaluatorNames": [
    "Telecom_Response_Quality_Evidence_v2",
    "Telecom_Tool_Correctness_Evidence_v2"
  ],
  "evaluatorWeightsByName": {
    "Telecom_Response_Quality_Evidence_v2": 50,
    "Telecom_Tool_Correctness_Evidence_v2": 50
  }
